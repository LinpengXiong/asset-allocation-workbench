<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.asset-allocation.wind-index</string>
  <key>ProgramArguments</key>
  <array>
    <string>/ABSOLUTE/PATH/TO/node</string>
    <string>--experimental-strip-types</string>
    <string>/ABSOLUTE/PATH/TO/scripts/sync-wind-index.mjs</string>
    <string>000001.SH</string>
    <string>--publish</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/asset-allocation-protected-site</string>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>10</integer></dict>
  <key>StandardOutPath</key><string>/tmp/asset-allocation-wind-index.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/asset-allocation-wind-index.err.log</string>
</dict>
</plist>

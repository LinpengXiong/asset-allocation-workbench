{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "multi-asset-allocation-advisor",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "multi-asset-allocation-db",
      "database_id": "d04dcbff-0db6-4dd2-99bd-e7d0d8e6964b"
    }
  ],
  "observability": {
    "enabled": true
  }
}

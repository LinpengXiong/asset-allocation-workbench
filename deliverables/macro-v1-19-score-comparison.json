    {
      "id": "G02",
      "name": "规模以上工业企业盈利增长与质量",
      "pillar": "增长动力",
      "group": "工业生产",
      "previousWeight": 0.04,
      "weight": 0.04,
      "currentWeight": 0.04,
      "previousScore": 3.4749349593495937,
      "currentScore": 3.5570833333333334,
      "previousContribution": 0.13899739837398375,
      "currentContribution": 0.14228333333333334,
      "contributionChange": 0.00328593495934959,
      "decision": "拆分",
      "reason": "盈利增长与质量、行业改善广度回答不同问题，分别占宏观总分4%，合计8%。本项移除原20%广度组件，其余四组件按原相对比例归一到50/25/12.5/12.5，锚点不动；保留总量和质量，避免广度既在本项又在G19重复加权。提高盈利组是已获确认的研究优先级，不是历史回测最优值。"
    },
    {
      "id": "G19",
      "name": "行业利润改善广度（规模以上工业，%）",
      "pillar": "增长动力",
      "group": "工业生产",
      "previousWeight": 0,
      "weight": 0.04,
      "currentWeight": 0.04,
      "previousScore": null,
      "currentScore": 3.1463414634146343,
      "previousContribution": 0,
      "currentContribution": 0.12585365853658537,
      "contributionChange": 0.12585365853658537,
      "decision": "独立广度",
      "reason": "单列覆盖面并提升到宏观总分4%，与盈利增长与质量4%等权，降低少数大行业拉高总利润时对分化的掩盖。原广度公式和锚点保持不变，等行业计数防止规模总量再次主导，但大小行业各一票也有局限；两项同源、并非完全独立，合计8%是研究试行偏好而非经回测证明的最优权重。"
    },
